datasource db {
  provider = "mysql"
}

generator client {
  provider     = "prisma-client-js"
  output       = "../prisma_client_mysql"
}

model User {
  user_id            Int      @id @default(autoincrement())
  full_name          String   @db.VarChar(100)
  username           String   @unique @db.VarChar(50)
  email              String   @unique @db.VarChar(100)
  phone_number       String?  @db.VarChar(20)
  password_hash      String   @db.Text
  user_address       String?  @db.Text
  landmark           String?  @db.VarChar(255)
  latitude           Decimal? @db.Decimal(12, 9)
  longitude          Decimal? @db.Decimal(12, 9)
  profile_photo_path String?  @db.VarChar(500)
  role               String   @default("user") @db.VarChar(50)
  status             String   @default("active") @db.VarChar(50)
  agency_id          Int?
  wallet_balance     Decimal  @default(0.00) @db.Decimal(10, 2)
  vehicle_numbers    String?  @db.VarChar(1000)
  driving_licence    String?  @db.VarChar(100)
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now()) @updatedAt

  @@map("users")
}

model OrgUser {
  org_id                     Int      @id @default(autoincrement())
  org_name                   String   @db.VarChar(200)
  username                   String   @unique @db.VarChar(50)
  email                      String   @unique @db.VarChar(100)
  phone_number               String?  @db.VarChar(20)
  password_hash              String   @db.Text
  org_address                String?  @db.Text
  landmark                   String?  @db.VarChar(255)
  latitude                   Decimal? @db.Decimal(12, 9)
  longitude                  Decimal? @db.Decimal(12, 9)
  profile_photo_path         String?  @db.VarChar(500)
  verification_document_path String?  @db.VarChar(500)
  aadhaar_card_path          String?  @db.VarChar(500)
  two_wheeler_capacity       Int      @default(0)
  three_wheeler_capacity     Int      @default(0)
  car_capacity               Int      @default(0)
  suv_capacity               Int      @default(0)
  van_capacity               Int      @default(0)
  pickup_capacity            Int      @default(0)
  ev_capacity                Int      @default(0)
  ev_charging_support        Boolean  @default(false)
  two_wheeler_rate           Decimal  @default(20) @db.Decimal(10, 2)
  three_wheeler_rate         Decimal  @default(30) @db.Decimal(10, 2)
  car_rate                   Decimal  @default(40) @db.Decimal(10, 2)
  suv_rate                   Decimal  @default(50) @db.Decimal(10, 2)
  van_rate                   Decimal  @default(50) @db.Decimal(10, 2)
  pickup_rate                Decimal  @default(50) @db.Decimal(10, 2)
  ev_rate                    Decimal  @default(60) @db.Decimal(10, 2)
  status                     String   @default("pending") @db.VarChar(50)
  commission_percentage      Decimal  @default(0.00) @db.Decimal(5, 2)
  wallet_balance             Decimal  @default(0.00) @db.Decimal(10, 2)
  created_at                 DateTime @default(now())
  updated_at                 DateTime @default(now()) @updatedAt
  cancellation_policy        String?  @db.Text
  require_booking_approval   Boolean  @default(false)
  cctv_available             Boolean  @default(false)
  trade_license              Boolean  @default(false)
  zoning_clearance           Boolean  @default(false)
  shops_establishment_license Boolean @default(false)
  gst_registration           Boolean  @default(false)

  @@map("org_users")
}

model AgencyTransaction {
  transaction_id   Int       @id @default(autoincrement())
  agency_id        Int
  booking_id       Int
  total_amount     Decimal   @db.Decimal(10, 2)
  approved_amount  Decimal?  @db.Decimal(10, 2)
  commission_rate  Decimal   @db.Decimal(5, 2)
  admin_share      Decimal   @db.Decimal(10, 2)
  agency_share     Decimal   @db.Decimal(10, 2)
  status           String    @default("pending") @db.VarChar(50)
  rejection_reason String?   @db.Text
  approved_by      Int?
  approved_at      DateTime?
  created_at       DateTime  @default(now())

  @@map("agency_transactions")
}

model Booking {
  booking_id          Int       @id @default(autoincrement())
  booking_code        String    @unique @db.VarChar(50)
  user_id             Int?
  user_name           String    @db.VarChar(100)
  user_phone          String?   @db.VarChar(20)
  agency_id           Int
  agency_name         String    @db.VarChar(200)
  vehicle_type        String    @db.VarChar(50)
  vehicle_number      String    @db.VarChar(50)
  status              String    @default("booked") @db.VarChar(50)
  start_time          DateTime?
  end_time            DateTime?
  booking_start_time  DateTime?
  booking_end_time    DateTime?
  checkin_time        DateTime?
  checkout_time       DateTime?
  booked_duration     Decimal   @db.Decimal(10, 2)
  hourly_rate         Decimal   @db.Decimal(10, 2)
  total_bill          Decimal   @default(0) @db.Decimal(10, 2)
  payment_status      String    @default("pending") @db.VarChar(50)
  otp                 String?   @db.VarChar(6)
  refund_amount       Decimal?  @default(0) @db.Decimal(10, 2)
  refund_notes        String?   @db.Text
  refunded_at         DateTime?
  refunded_by         Int?
  is_force_cancelled  Boolean   @default(false)
  cancelled_by        String?   @db.VarChar(50)
  cancellation_reason String?   @db.Text
  approved_by         Int?
  approved_at         DateTime?
  rejected_by         Int?
  rejected_at         DateTime?
  rejection_reason    String?   @db.Text
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now()) @updatedAt

  @@map("bookings")
}

model WalletTransaction {
  transaction_id     Int      @id @default(autoincrement())
  user_id            Int
  agency_id          Int?
  amount             Decimal  @db.Decimal(10, 2)
  type               String   @db.VarChar(50) // "deposit" or "withdrawal"
  status             String   @default("pending") @db.VarChar(50) // "pending", "approved", "rejected"
  transaction_number String?  @db.VarChar(100)
  screenshot_path    String?  @db.VarChar(500)
  rejection_reason   String?  @db.Text
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now()) @updatedAt

  @@map("wallet_transactions")
}

model Configuration {
  config_id    Int    @id @default(autoincrement())
  config_key   String @unique @db.VarChar(100)
  config_value String @db.Text

  @@map("configurations")
}

model Rating {
  rating_id   Int      @id @default(autoincrement())
  user_id     Int
  agency_id   Int
  booking_id  Int?
  rating      Int      @db.TinyInt
  review      String?  @db.Text
  rating_type String   @default("user_to_agency") @db.VarChar(50)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  @@unique([booking_id, rating_type], name: "booking_rating_type")
  @@map("ratings")
}

model Notification {
  notification_id Int      @id @default(autoincrement())
  recipient_id     Int      // user_id or org_id of whoever should see it
  type             String   @db.VarChar(100)
  title             String   @db.VarChar(255)
  message           String   @db.Text
  data              String?  @db.Text // JSON-stringified extra payload
  is_read           Boolean  @default(false)
  created_at        DateTime @default(now())

  @@index([recipient_id, created_at])
  @@map("notifications")
}

model NotificationPreference {
  recipient_id Int      @id
  enabled      Boolean  @default(true)
  updated_at   DateTime @default(now()) @updatedAt

  @@map("notification_preferences")
}

model OrgMedia {
  media_id          Int      @id @default(autoincrement())
  org_id            Int
  file_path         String   @db.VarChar(500)
  pending_file_path String?  @db.VarChar(500)
  file_type         String   @default("photo") @db.VarChar(50) // "photo" or "video"
  status            String   @default("pending") @db.VarChar(50) // "pending", "approved", "rejected"
  rejection_reason  String?  @db.Text
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now()) @updatedAt

  @@index([org_id])
  @@map("org_media")
}

model OrgWorkingHours {
  id                         Int      @id @default(autoincrement())
  org_id                     Int      @unique
  working_days               String?  @db.Text
  open_time                  String?  @db.VarChar(10)
  close_time                 String?  @db.VarChar(10)
  is_24_7                    Boolean  @default(false)
  special_vacations          String?  @db.Text
  daily_schedules            String?  @db.Text
  pending_working_days       String?  @db.Text
  pending_open_time          String?  @db.VarChar(10)
  pending_close_time         String?  @db.VarChar(10)
  pending_is_24_7            Boolean  @default(false)
  pending_special_vacations  String?  @db.Text
  pending_daily_schedules    String?  @db.Text
  status                     String   @default("approved") @db.VarChar(50) // "approved", "pending", "rejected"
  rejection_reason           String?  @db.Text
  created_at                 DateTime @default(now())
  updated_at                 DateTime @default(now()) @updatedAt

  @@map("org_working_hours")
}

model Complaint {
  complaint_id     Int       @id @default(autoincrement())
  booking_id       Int
  user_id          Int
  agency_id        Int
  complainant_type String    @default("user_to_agency") @db.VarChar(50)
  complainant_id   Int
  subject          String?   @db.VarChar(255)
  description      String    @db.Text
  status           String    @default("pending") @db.VarChar(50)
  resolution_notes String?   @db.Text
  resolved_by      Int?
  resolved_at      DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime        @default(now()) @updatedAt
  steps            ComplaintStep[]

  @@unique([booking_id, complainant_type], name: "booking_complainant_type")
  @@map("complaints")
}

model ComplaintStep {
  step_id         Int       @id @default(autoincrement())
  complaint_id    Int
  step_number     Int       @default(1)
  action_by_role  String    @db.VarChar(50)
  action_by_id    Int
  previous_status String?   @db.VarChar(50)
  new_status      String    @db.VarChar(50)
  comment         String    @db.Text
  created_at      DateTime  @default(now())

  complaint       Complaint @relation(fields: [complaint_id], references: [complaint_id], onDelete: Cascade)

  @@map("complaint_steps")
}

model UserStatusLog {
  log_id          Int      @id @default(autoincrement())
  user_id         Int
  previous_status String   @db.VarChar(50)
  new_status      String   @db.VarChar(50)
  reason          String   @db.Text
  changed_by      Int // admin's user_id (or org_id) who made the change
  changed_by_role String   @db.VarChar(50)
  created_at      DateTime @default(now())

  @@index([user_id])
  @@map("user_status_logs")
}